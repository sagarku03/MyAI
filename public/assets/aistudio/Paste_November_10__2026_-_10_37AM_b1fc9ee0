    var fileTree by remember(rootDirectory) { mutableStateOf(buildFileTree(rootDirectory)) }

    Column(
        modifier = modifier
            .fillMaxHeight()
            .width(260.dp)
            .background(Color(0xFF0F172A))
            .padding(8.dp)
    ) {
