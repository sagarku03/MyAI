<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <permission
        android:name="${applicationId}.permission.RUN_COMMAND"
        android:protectionLevel="signature" />
    <permission
        android:name="${applicationId}.permission.API"
        android:protectionLevel="signature" />

    <uses-permission android:name="${applicationId}.permission.RUN_COMMAND" />
    <uses-permission android:name="${applicationId}.permission.API" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Storage Permissions for Local Bootstrap ZIP Auto-Detection -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.proximity"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <queries>
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.google.android.calendar" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.google.android.contacts" />
        <package android:name="com.google.android.dialer" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.instagram.android" />
        <package android:name="com.spotify.music" />
        <package android:name="com.termux" />
        <package android:name="com.termux.api" />
        <package android:name="ai.agentra.api" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <application
        android:name="com.jarvisai.assistant.AgentraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:manageSpaceActivity="com.jarvisai.assistant.security.ManageSpaceActivity"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.main"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="⚡ Send to Agentra">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="⚡ Analyze with Agentra">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service
            android:name="com.jarvisai.assistant.service.LiveVoiceForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps Agentra live voice assistant session and floating HUD active across apps" />
        </service>

        <!-- Antigravity native live voice call microphone service -->
        <service
            android:name="com.jarvisai.assistant.voice.agy.AgyVoiceCallService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Antigravity Voice call Quick Settings tile & translucent launch bridge -->
        <service
            android:name="com.jarvisai.assistant.voice.agy.VoiceCallTileService"
            android:exported="true"
            android:icon="@drawable/ic_voice_call"
            android:label="Voice call"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name="com.jarvisai.assistant.voice.agy.VoiceCallLaunchActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="ai.agentra.voicecall.CALL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="com.jarvisai.assistant.service.JarvisOverlayHudService"
            android:enabled="true"
            android:exported="false" />

        <!-- Phase 9: Android Quick Settings Tile Service -->
        <service
            android:name="com.jarvisai.assistant.service.JarvisTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.jarvisai.assistant.service.JarvisAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name="com.jarvisai.assistant.service.JarvisNotificationListenerService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/system_notif_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Android System Default Digital Assistant -->
        <service
            android:name="com.jarvisai.assistant.assistant.JarvisVoiceInteractionService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/system_assistant_label"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/jarvis_interaction_service" />
        </service>

        <service
            android:name="com.jarvisai.assistant.assistant.JarvisVoiceSessionService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name="com.jarvisai.assistant.assistant.JarvisRecognitionService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/system_assistant_label">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/jarvis_recognition_service" />
        </service>

        <activity
            android:name="com.jarvisai.assistant.assistant.JarvisAssistActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Interactive Sci-Fi Arc Reactor Live Wallpaper -->
        <service
            android:name="com.jarvisai.assistant.wallpaper.JarvisWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/system_wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/jarvis_wallpaper" />
        </service>

        <!-- In-App AI Web Browser -->
        <activity
            android:name="com.jarvisai.assistant.browser.JarvisBrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize" />

        <!-- Broadcast Receivers -->
        <receiver
            android:name="com.jarvisai.assistant.telephony.JarvisPhoneStateReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.jarvisai.assistant.core.JarvisBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.jarvisai.assistant.driving.JarvisDrivingOffReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jarvisai.assistant.DRIVING_OFF" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.jarvisai.assistant.termux.JarvisTermuxResultReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Standalone Terminal Emulator Activity (Separate Task for Dual App Icon) -->
        <activity
            android:name="com.jarvisai.assistant.terminal.TermuxActivity"
            android:exported="true"
            android:label="Agentra Terminal"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.terminal"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Dual App Launcher Alias 1: Agentra Term -->
        <activity-alias
            android:name="com.jarvisai.assistant.AgentraTermAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/agentra_term_name"
            android:targetActivity="com.jarvisai.assistant.terminal.TermuxActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dual App Launcher Alias 2: Classic Termux -->
        <activity-alias
            android:name="com.jarvisai.assistant.ClassicTermAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_termux_launcher"
            android:roundIcon="@mipmap/ic_termux_launcher_round"
            android:label="@string/termux_name"
            android:targetActivity="com.jarvisai.assistant.terminal.TermuxActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Core Termux Background Service -->
        <service
            android:name="com.jarvisai.assistant.service.TermuxService"
            android:exported="true"
            android:permission="${applicationId}.permission.RUN_COMMAND"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains active Linux PTY terminal sessions and background developer daemons" />
        </service>

        <!-- Component Wrappers for Byte-Relocated ai.agentra.app.* Scripts -->
        <activity
            android:name="ai.agentra.app.TermuxOpenActivity"
            android:exported="true"
            android:permission="${applicationId}.permission.RUN_COMMAND"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="${applicationId}.app.TermuxUrlOpenActivity" />
                <action android:name="${applicationId}.app.TermuxOpenActivity" />
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name="ai.agentra.app.TermuxSystemReceiver"
            android:exported="true"
            android:permission="${applicationId}.permission.RUN_COMMAND">
            <intent-filter>
                <action android:name="${applicationId}.app.request_storage_permissions" />
                <action android:name="${applicationId}.app.reload_style" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="ai.agentra.app.TermuxOpenReceiver"
            android:exported="true"
            android:permission="${applicationId}.permission.RUN_COMMAND">
            <intent-filter>
                <action android:name="${applicationId}.app.TermuxOpenReceiver" />
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service
            android:name="ai.agentra.app.TermuxService"
            android:enabled="true"
            android:exported="true"
            android:permission="${applicationId}.permission.RUN_COMMAND"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Background terminal and AI language server execution" />
            <intent-filter>
                <action android:name="${applicationId}.service_wake_lock" />
                <action android:name="${applicationId}.service_wake_unlock" />
                <action android:name="${applicationId}.service_stop" />
            </intent-filter>
        </service>

        <!-- Termux Open Activity (com.termux compatibility) -->
        <activity
            android:name="com.termux.app.TermuxOpenActivity"
            android:exported="true"
            android:permission="${applicationId}.permission.RUN_COMMAND"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.termux.app.TermuxUrlOpenActivity" />
                <action android:name="com.termux.app.TermuxOpenActivity" />
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Termux System Receiver (com.termux compatibility) -->
        <receiver
            android:name="com.termux.app.TermuxSystemReceiver"
            android:exported="true"
            android:permission="${applicationId}.permission.RUN_COMMAND">
            <intent-filter>
                <action android:name="com.termux.app.request_storage_permissions" />
                <action android:name="com.termux.app.reload_style" />
            </intent-filter>
        </receiver>

        <!-- Termux Open Receiver (com.termux compatibility) -->
        <receiver
            android:name="com.termux.app.TermuxOpenReceiver"
            android:exported="true"
            android:permission="${applicationId}.permission.RUN_COMMAND">
            <intent-filter>
                <action android:name="com.termux.app.TermuxOpenReceiver" />
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Component Alias for Termux scripts calling com.termux.app.TermuxService -->
        <service
            android:name="com.termux.app.TermuxService"
            android:enabled="true"
            android:exported="true"
            android:permission="${applicationId}.permission.RUN_COMMAND"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Background terminal and AI language server execution" />
            <intent-filter>
                <action android:name="com.termux.service_wake_lock" />
                <action android:name="com.termux.service_wake_unlock" />
                <action android:name="com.termux.service_stop" />
            </intent-filter>
        </service>

        <!-- Termux API Subsystem Broadcast Receiver -->
        <receiver
            android:name="com.jarvisai.assistant.receiver.TermuxApiReceiver"
            android:exported="true"
            android:permission="${applicationId}.permission.API">
            <intent-filter>
                <action android:name="${applicationId}.api.ACTION_API" />
                <action android:name="${applicationId}.api" />
                <action android:name="com.termux.api.ACTION_API" />
                <action android:name="com.termux.api" />
            </intent-filter>
        </receiver>

        <!-- Wireless Debugging Notification Pairing Service -->
        <service
            android:name="com.jarvisai.assistant.adb.AdbPairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays Wireless Debugging pairing code input notification while user is in Developer Options" />
        </service>

        <!-- Disabled duplicate legacy accessibility service; JarvisAccessibilityService handles unified automation -->
        <service
            android:name="com.jarvisai.assistant.service.AutomationAccessibilityService"
            android:enabled="false"
            android:exported="false"
            android:label="Agentra Legacy Automation Bridge"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/automation_accessibility_service" />
        </service>

        <!-- Manage Space Activity (Android Settings Clear Storage Interceptor) -->
        <activity
            android:name="com.jarvisai.assistant.security.ManageSpaceActivity"
            android:exported="true"
            android:label="Agentra Space &amp; Safety Shield"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MANAGE_SPACE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Enterprise Device Admin Receiver (Anti-Uninstall Shield) -->
        <receiver
            android:name="com.jarvisai.assistant.security.JarvisDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Phase 11: Floating Overlay ChatHead Bubble Service -->
        <service
            android:name="com.jarvisai.assistant.ui.bubble.FloatingBubbleService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays floating ChatHead overlay bubble across apps for instant agent access" />
        </service>

        <!-- Phase 11: FileProvider for In-App GitHub APK Self-Updater -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Global Process-Isolated Crash Recovery Activity -->
        <activity
            android:name="com.jarvisai.assistant.crash.CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":crash"
            android:theme="@style/Theme.MyApplication" />

        <!-- Sandboxed Agentra Mini-Apps WebView Host -->
        <activity
            android:name="com.jarvisai.assistant.ui.miniapps.MiniAppActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
