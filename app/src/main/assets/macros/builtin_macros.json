{
  "version": 4,
  "macros": [
    {
      "name": "chatgpt image",
      "intent": "ChatGPT app me image generate karo aur gallery me save karo",
      "params": ["image_prompt"],
      "steps": [
        { "tool": "open_app_by_name", "args": { "name": "ChatGPT" } },
        { "tool": "wait", "args": { "seconds": 4 } },
        { "tool": "tap_text", "args": { "text": "New chat", "_optional": true } },
        { "tool": "wait", "args": { "seconds": 3 } },
        { "tool": "type_text", "args": { "text": "Create an image: {image_prompt}" } },
        { "tool": "tap_text", "args": { "text": "Send Message" } },
        { "tool": "wait_for_screen_text", "args": { "text": "Creating image", "mode": "disappear", "timeout_seconds": 180 } },
        { "tool": "wait", "args": { "seconds": 2 } },
        { "tool": "tap_text", "args": { "text": "Share" } },
        { "tool": "wait", "args": { "seconds": 2 } },
        { "tool": "tap_text", "args": { "text": "Download" } },
        { "tool": "wait", "args": { "seconds": 2 } }
      ]
    },
    {
      "name": "gemini image",
      "intent": "Gemini app me Images tool se image banao aur gallery me save karo",
      "params": ["image_prompt"],
      "steps": [
        { "tool": "open_app_by_name", "args": { "name": "Gemini" } },
        { "tool": "wait", "args": { "seconds": 4 } },
        { "tool": "tap_text", "args": { "text": "New chat", "_optional": true } },
        { "tool": "wait", "args": { "seconds": 2 } },
        { "tool": "tap_text", "args": { "text": "Add attachments" } },
        { "tool": "wait", "args": { "seconds": 2 } },
        { "tool": "tap_text", "args": { "text": "Images" } },
        { "tool": "wait", "args": { "seconds": 2 } },
        { "tool": "type_text", "args": { "text": "{image_prompt}" } },
        { "tool": "tap_text", "args": { "text": "Send" } },
        { "tool": "wait_for_screen_text", "args": { "text": "Generated image", "mode": "appear", "timeout_seconds": 180 } },
        { "tool": "wait", "args": { "seconds": 2 } },
        { "tool": "tap_text", "args": { "text": "Save" } }
      ]
    },
    {
      "name": "youtube play song",
      "intent": "YouTube open karo aur pehla song play karo",
      "params": ["song_query"],
      "steps": [
        { "tool": "open_app_by_name", "args": { "name": "YouTube" } },
        { "tool": "wait", "args": { "seconds": 3 } },
        { "tool": "tap_text", "args": { "text": "Search", "_optional": true } },
        { "tool": "wait", "args": { "seconds": 2 } },
        { "tool": "type_text", "args": { "text": "{song_query}" } },
        { "tool": "wait", "args": { "seconds": 2 } },
        { "tool": "tap_text", "args": { "text": "{song_query}" } },
        { "tool": "wait_for_screen_text", "args": { "text": "views", "mode": "appear", "timeout_seconds": 15 } }
      ]
    },
    {
      "name": "chatgpt se poochho",
      "intent": "ChatGPT app me sawaal poochho aur jawab padhke sunao",
      "params": ["sawaal"],
      "steps": [
        { "tool": "open_app_by_name", "args": { "name": "ChatGPT" } },
        { "tool": "wait", "args": { "seconds": 4 } },
        { "tool": "tap_text", "args": { "text": "New chat", "_optional": true } },
        { "tool": "wait", "args": { "seconds": 3 } },
        { "tool": "type_text", "args": { "text": "{sawaal}" } },
        { "tool": "tap_text", "args": { "text": "Send Message" } },
        { "tool": "wait", "args": { "seconds": 10 } },
        { "tool": "read_screen_text", "args": {} }
      ]
    }
  ]
}
